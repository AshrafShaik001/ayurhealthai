# ═══════════════════════════════════════════════════════════════
#  AyurHealthAI — Server Environment Variables
#  Copy this file: cp .env.example .env
#  Fill in your actual values in .env (never commit .env to git)
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
# Port the Express server listens on
PORT=5001

# Set to 'production' when deploying
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get from: Atlas → Cluster → Connect → Drivers → Node.js
# Replace <username>, <password>, and <cluster-url>
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ayurai?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────
# URL of the frontend (no trailing slash)
# Development: http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ── Anthropic Claude AI ───────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
# Starts with: sk-ant-
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Authentication ────────────────────────────────────────────
# Random secret for signing JWTs — must be at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_64_characters_here
